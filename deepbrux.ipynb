import numpy as np
import pandas as pd
import scipy.signal as sps
import pywt
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation
from IPython.display import HTML
from collections import Counter, defaultdict
import os
import shutil

# --- Parameters ---
file_list = ['brux_log_008.csv','brux_log_011.csv','brux_log_012.csv','brux_log_013.csv',
             'brux_log_014.csv','brux_log_015.csv','brux_log_017.csv','brux_log_018.csv']
trim_start = [29,53,20,45,31,25,46,49]
trim_end   = [110,10,7,6,5,5,15,5]
fs_target = 200

seg_dur = 10
samps_per_seg = fs_target * seg_dur

# Band-pass filter parameters
lowcut_freq = 0.5
highcut_freq = 105.0
filter_order = 4

# --- Containers ---
all_signals_per_file = []
file_signal_lengths = []

# --- Preprocessing (with visualization) ---
for idx_file, fname in enumerate(file_list):
    print(f"\nProcessing file: {fname}")
    df = pd.read_csv(fname)
    time_raw = df.iloc[:, 0].values / 1e6
    time_raw -= time_raw[0]
    sig_raw = df.iloc[:, 1].values

    # --- Plot: Raw signal ---
    plt.figure(figsize=(12, 2))
    plt.plot(time_raw, sig_raw)
    plt.title("Raw Signal")
    plt.xlabel("Time (s)")
    plt.ylabel("Amplitude")
    plt.show()

    # --- Trim ---
    s, e = trim_start[idx_file], trim_end[idx_file]
    mask = (time_raw >= s) & (time_raw <= time_raw[-1] - e)
    t_trim, x_trim = time_raw[mask], sig_raw[mask]

    plt.figure(figsize=(12, 2))
    plt.plot(t_trim, x_trim)
    plt.title("Trimmed Signal")
    plt.xlabel("Time (s)")
    plt.ylabel("Amplitude")
    plt.show()

    # --- Outlier removal ---
    m = np.ma.masked_outside(x_trim, np.percentile(x_trim, 5), np.percentile(x_trim, 95))
    med = np.median(x_trim)
    stdv = np.std(x_trim)
    mask2 = np.abs(x_trim - med) > 3 * stdv
    mask_combined = m.mask | mask2
    clean = x_trim.copy()
    good = ~mask_combined
    clean[mask_combined] = np.interp(np.flatnonzero(mask_combined), np.flatnonzero(good), clean[good])

    plt.figure(figsize=(12, 2))
    plt.plot(t_trim, clean)
    plt.title("Outlier Removed")
    plt.xlabel("Time (s)")
    plt.ylabel("Amplitude")
    plt.show()

    # --- Denoise (Wavelet only) ---
    clean = sps.medfilt(clean, kernel_size=5)
    coeffs = pywt.wavedec(clean, 'sym4', level=5)
    coeffs[1:] = [pywt.threshold(c, np.std(c)/2, mode='soft') for c in coeffs[1:]]
    denoised = pywt.waverec(coeffs, 'sym4')

    plt.figure(figsize=(12, 2))
    plt.plot(t_trim[:len(denoised)], denoised)
    plt.title("Denoised Signal (Wavelet Only)")
    plt.xlabel("Time (s)")
    plt.ylabel("Amplitude")
    plt.show()

    # --- Filtering ---
    nyquist = 0.5 * fs_target
    low = lowcut_freq / nyquist
    high = min(highcut_freq / nyquist, 0.999)

    if low <= 0 or high >= 1 or low >= high:
        print(f"⚠️ Skipping filtering for {fname} due to invalid band: low={low}, high={high}")
        filtered_signal = denoised
    else:
        b, a = sps.butter(filter_order, [low, high], btype='band')
        filtered_signal = sps.lfilter(b, a, denoised)

    plt.figure(figsize=(12, 2))
    plt.plot(filtered_signal)
    plt.title("Filtered Signal")
    plt.xlabel("Samples")
    plt.ylabel("Amplitude")
    plt.show()

    # --- Standardization ---
    mean_val = np.mean(filtered_signal)
    std_val = np.std(filtered_signal)
    standardized_signal = (filtered_signal - mean_val) / (std_val + 1e-8)

    plt.figure(figsize=(12, 2))
    plt.plot(standardized_signal)
    plt.title("Standardized Signal")
    plt.xlabel("Samples")
    plt.ylabel("Z-score")
    plt.show()

    # --- Frequency-domain plot ---
    freqs = np.fft.rfftfreq(len(standardized_signal), d=1/fs_target)
    fft_vals = np.abs(np.fft.rfft(standardized_signal))

    plt.figure(figsize=(12, 3))
    plt.plot(freqs, fft_vals)
    plt.title("Frequency Spectrum")
    plt.xlabel("Frequency (Hz)")
    plt.ylabel("Magnitude")
    plt.grid(True)
    plt.show()

    all_signals_per_file.append(standardized_signal)
    file_signal_lengths.append(len(standardized_signal))

# --- Labeling / Segmentation ---
labels_cycle = ["Clenching", "Chewing", "Yawning", "Talking", "Rest"]

segments = []
X_raw = []
Y_raw_labels = []
segment_file_ids = []

for file_idx, signal in enumerate(all_signals_per_file):
    num_segments = len(signal) // samps_per_seg

    if file_idx == 7:  # brux_log_018.csv: skip only the first Clenching
        full_cycle = labels_cycle * ((num_segments // len(labels_cycle)) + 2)
        file_labels = full_cycle[1:num_segments+1]  # skip the first label (Clenching)
    else:
        full_cycle = labels_cycle * ((num_segments // len(labels_cycle)) + 1)
        file_labels = full_cycle[:num_segments]

    for i in range(num_segments):
        start = i * samps_per_seg
        end = start + samps_per_seg
        seg = signal[start:end]
        label = file_labels[i]

        segments.append((seg, label))
        X_raw.append(seg)
        Y_raw_labels.append(label)
        segment_file_ids.append(file_idx)

print("\n✅ Segmentation complete.")
print("Segment label counts:", Counter(Y_raw_labels))


# --- Save and visualize spectrograms ---
out_dir = "spectrogram_dataset"
if os.path.exists(out_dir):
    shutil.rmtree(out_dir)
os.makedirs(out_dir)

# Track samples to visualize
max_to_show = 5
samples_to_plot = defaultdict(list)

for idx, (segment, label) in enumerate(segments):
    label_dir = os.path.join(out_dir, label)
    os.makedirs(label_dir, exist_ok=True)

    f, t, Sxx = sps.spectrogram(segment, fs=fs_target)
    S_dB = 10 * np.log10(Sxx + 1e-10)

    plt.figure(figsize=(2.5, 2.5))
    plt.pcolormesh(t, f, S_dB, shading='gouraud', cmap='inferno')
    plt.axis('off')
    filename = os.path.join(label_dir, f"seg_{idx:03d}.png")
    plt.savefig(filename, bbox_inches='tight', pad_inches=0)
    plt.close()

    if len(samples_to_plot[label]) < max_to_show:
        samples_to_plot[label].append((t, f, S_dB))

# --- Plot sample spectrograms per class ---
for label, specs in samples_to_plot.items():
    fig, axs = plt.subplots(1, len(specs), figsize=(3 * len(specs), 3))
    fig.suptitle(f"Spectrograms for Class: {label}", fontsize=14)

    if len(specs) == 1:
        axs = [axs]

    for ax, (t, f, S_dB) in zip(axs, specs):
        im = ax.pcolormesh(t, f, S_dB, shading='gouraud', cmap='inferno')
        ax.axis('off')

    plt.tight_layout(rect=[0, 0, 1, 0.95])
    plt.show()

# --- Animate sliding window segmentation ---
fig, ax = plt.subplots(figsize=(12, 3))
window_line, = ax.plot([], [], lw=2)
ax.set_xlim(0, samps_per_seg)
ax.set_ylim(min([min(sig) for sig in all_signals_per_file]), max([max(sig) for sig in all_signals_per_file]))
title = ax.set_title("")

def init():
    window_line.set_data([], [])
    title.set_text("")
    return [window_line, title]

def update(frame):
    seg = X_raw[frame]
    window_line.set_data(np.arange(samps_per_seg), seg)
    label = Y_raw_labels[frame]
    fname = file_list[segment_file_ids[frame]]
    title.set_text(f"Segment {frame+1} - Label: {label} - File: {fname}")
    return [window_line, title]

ani = FuncAnimation(fig, update, frames=len(X_raw), init_func=init, blit=True, interval=1000)
plt.close(fig)
HTML(ani.to_jshtml())


#SENSOR LETTERS
import os
import torch
import torch.nn as nn
import torch.optim as optim
from torchvision import datasets, transforms, models
from torch.utils.data import DataLoader, Subset
from sklearn.model_selection import train_test_split
from sklearn.metrics import classification_report, confusion_matrix
from sklearn.utils.class_weight import compute_class_weight
import numpy as np
import random
import matplotlib.pyplot as plt
import seaborn as sns
from PIL import Image
import torchvision.transforms.functional as TF

# --- Reproducibility ---
SEED = 42
random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)
torch.cuda.manual_seed(SEED)
torch.cuda.manual_seed_all(SEED)
torch.backends.cudnn.deterministic = True
torch.backends.cudnn.benchmark = False
torch_gen = torch.Generator().manual_seed(SEED)

# --- Settings ---
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
data_dir = "spectrogram_dataset"  # Set your path
batch_size = 32
num_epochs = 50
learning_rate = 0.0001
img_size = 224
patience = 10

# --- Dataset Check ---
if not os.path.exists(data_dir):
    raise FileNotFoundError(f"Dataset not found at {data_dir}")

# --- Custom SpecAugment Transform ---
class SpectrogramTransform:
    def __init__(self, is_train=True):
        self.is_train = is_train

    def __call__(self, img):
        img = TF.to_tensor(img)

        if self.is_train:
            if torch.rand(1, generator=torch_gen).item() > 0.5:
                mask_width = torch.randint(1, 20, (1,), generator=torch_gen).item()
                if img.shape[2] > mask_width:
                    mask_start = torch.randint(0, img.shape[2] - mask_width, (1,), generator=torch_gen).item()
                    img[:, :, mask_start:mask_start + mask_width] = 0
            if torch.rand(1, generator=torch_gen).item() > 0.5:
                mask_height = torch.randint(1, 20, (1,), generator=torch_gen).item()
                if img.shape[1] > mask_height:
                    mask_start = torch.randint(0, img.shape[1] - mask_height, (1,), generator=torch_gen).item()
                    img[:, mask_start:mask_start + mask_height, :] = 0

        return img

# --- Transforms ---
train_transform = transforms.Compose([
    transforms.Resize((img_size, img_size)),
    transforms.RandomHorizontalFlip(0.3),
    transforms.ColorJitter(0.1, 0.1),
    SpectrogramTransform(is_train=True),
    transforms.Normalize([0.485, 0.456, 0.406],
                         [0.229, 0.224, 0.225])
])
val_transform = transforms.Compose([
    transforms.Resize((img_size, img_size)),
    transforms.ToTensor(),
    transforms.Normalize([0.485, 0.456, 0.406],
                         [0.229, 0.224, 0.225])
])

# --- Load Data ---
temp_dataset = datasets.ImageFolder(data_dir, transform=transforms.ToTensor())
class_names = temp_dataset.classes
num_classes = len(class_names)

targets = [label for _, label in temp_dataset.samples]
train_idx, val_idx = train_test_split(
    list(range(len(temp_dataset))),
    test_size=0.2,
    stratify=targets,
    random_state=SEED
)

train_dataset = datasets.ImageFolder(data_dir, transform=train_transform)
val_dataset = datasets.ImageFolder(data_dir, transform=val_transform)

train_set = Subset(train_dataset, train_idx)
val_set = Subset(val_dataset, val_idx)

train_loader = DataLoader(train_set, batch_size=batch_size, shuffle=True, num_workers=0, generator=torch_gen)
val_loader = DataLoader(val_set, batch_size=batch_size, shuffle=False, num_workers=0)

# --- Class Weights ---
train_targets = [temp_dataset.samples[i][1] for i in train_idx]
class_weights = compute_class_weight('balanced', classes=np.unique(train_targets), y=train_targets)
class_weights = torch.tensor(class_weights, dtype=torch.float32).to(device)

# --- Load Model ---
model = models.resnet18(pretrained=True)
model.fc = nn.Sequential(
    nn.Dropout(0.5),
    nn.Linear(model.fc.in_features, 256),
    nn.ReLU(),
    nn.Dropout(0.3),
    nn.Linear(256, num_classes)
)
model = model.to(device)

# --- Loss, Optimizer, Scheduler ---
criterion = nn.CrossEntropyLoss(weight=class_weights, label_smoothing=0.1)
optimizer = optim.AdamW(model.parameters(), lr=learning_rate, weight_decay=0.01)
scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=num_epochs, eta_min=1e-6)

# --- Training Functions ---
def train_epoch(model, dataloader, criterion, optimizer):
    model.train()
    total_loss, correct, total = 0, 0, 0
    for inputs, targets in dataloader:
        inputs, targets = inputs.to(device), targets.to(device)
        optimizer.zero_grad()
        outputs = model(inputs)
        loss = criterion(outputs, targets)
        loss.backward()
        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
        optimizer.step()
        total_loss += loss.item() * inputs.size(0)
        correct += (outputs.argmax(1) == targets).sum().item()
        total += targets.size(0)
    return total_loss / total, correct / total

def validate_epoch(model, dataloader, criterion):
    model.eval()
    total_loss, correct, total = 0, 0, 0
    all_preds, all_targets = [], []
    with torch.no_grad():
        for inputs, targets in dataloader:
            inputs, targets = inputs.to(device), targets.to(device)
            outputs = model(inputs)
            loss = criterion(outputs, targets)
            total_loss += loss.item() * inputs.size(0)
            preds = outputs.argmax(1)
            correct += (preds == targets).sum().item()
            total += targets.size(0)
            all_preds.extend(preds.cpu().numpy())
            all_targets.extend(targets.cpu().numpy())
    return total_loss / total, correct / total, all_preds, all_targets

# --- Training Loop ---
train_losses, val_losses, train_accuracies, val_accuracies = [], [], [], []
best_val_acc = 0
patience_counter = 0

for epoch in range(num_epochs):
    print(f"\nEpoch {epoch+1}/{num_epochs}")
    train_loss, train_acc = train_epoch(model, train_loader, criterion, optimizer)
    val_loss, val_acc, _, _ = validate_epoch(model, val_loader, criterion)

    train_losses.append(train_loss)
    val_losses.append(val_loss)
    train_accuracies.append(train_acc)
    val_accuracies.append(val_acc)
    scheduler.step()

    print(f"Train Loss: {train_loss:.4f}, Train Acc: {train_acc:.4f}")
    print(f"Val   Loss: {val_loss:.4f}, Val   Acc: {val_acc:.4f}")

    if val_acc > best_val_acc:
        best_val_acc = val_acc
        patience_counter = 0
        torch.save({
            'epoch': epoch,
            'model_state_dict': model.state_dict(),
            'optimizer_state_dict': optimizer.state_dict(),
            'best_val_acc': best_val_acc,
            'class_names': class_names,
            'seed': SEED,
            'train_idx': train_idx,
            'val_idx': val_idx
        }, 'best_spectrogram_model.pt')
        print("✓ Model saved.")
    else:
        patience_counter += 1
        if patience_counter >= patience:
            print("Early stopping.")
            break

# --- Final Evaluation ---
checkpoint = torch.load('best_spectrogram_model.pt')
model.load_state_dict(checkpoint['model_state_dict'])

_, _, all_preds, all_targets = validate_epoch(model, val_loader, criterion)

# --- Confusion Matrix ---
cm = confusion_matrix(all_targets, all_preds)
plt.figure(figsize=(8, 6))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=class_names, yticklabels=class_names)
plt.xlabel("Predicted")
plt.ylabel("Actual")
plt.title(f"Confusion Matrix (Val Acc: {best_val_acc:.2%})")
plt.tight_layout()
plt.savefig("confusion_matrix.png")
plt.show()

# --- Classification Report ---
print("\nClassification Report:")
print(classification_report(all_targets, all_preds, target_names=class_names))

# --- Training Curves ---
plt.figure(figsize=(12, 4))
plt.subplot(1, 2, 1)
plt.plot(train_losses, label="Train Loss")
plt.plot(val_losses, label="Val Loss")
plt.xlabel("Epoch")
plt.ylabel("Loss")
plt.legend()

plt.subplot(1, 2, 2)
plt.plot(train_accuracies, label="Train Acc")
plt.plot(val_accuracies, label="Val Acc")
plt.xlabel("Epoch")
plt.ylabel("Accuracy")
plt.legend()
plt.tight_layout()
plt.savefig("training_curves.png")
plt.show()

print(f"\n✅ Done. Best Val Acc: {best_val_acc:.2%}")
